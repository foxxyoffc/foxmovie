generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model Anime {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  coverImage  String?
  bannerImage String?
  year        Int?
  status      String?  // Ongoing, Completed, Hiatus
  genre       String[]
  rating      Float?
  totalEpisodes Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  episodes    Episode[]
  sources     AnimeSource[]
}

model Episode {
  id          String   @id @default(cuid())
  animeId     String
  anime       Anime    @relation(fields: [animeId], references: [id])
  number      Int
  title       String?
  thumbnail   String?
  duration    Int?     // in minutes
  releaseDate DateTime?
  createdAt   DateTime @default(now())
  
  streams     Stream[]
  
  @@unique([animeId, number])
}

model Stream {
  id          String   @id @default(cuid())
  episodeId   String
  episode     Episode  @relation(fields: [episodeId], references: [id])
  quality     String   // 1080p, 720p, 480p, 360p
  url         String   @db.Text
  source      String   // gogoanime, zoro, animeheaven, etc.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model AnimeSource {
  id          String   @id @default(cuid())
  animeId     String
  anime       Anime    @relation(fields: [animeId], references: [id])
  source      String   // gogoanime, zoro, etc.
  externalId  String   // ID di source tersebut
  url         String   @db.Text
  lastSync    DateTime @default(now())
  isActive    Boolean  @default(true)
  
  @@unique([animeId, source])
}
