{
  "functions": {
    "app/api/auto-update/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/auto-update",
      "schedule": "0 */6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
